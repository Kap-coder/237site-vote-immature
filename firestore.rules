rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    //   - id: string (required)
    //   - name: string
    //   - email: string (required)
    //   - hasVoted: bool (required)
    //   - role: string (user|admin)
    //
    // Collection: candidates
    //   - name: string (required)
    //   - description: string
    //   - image: string
    //   - voteCount: number (required)
    //
    // Collection: votes
    //   - userId: string (required)
    //   - candidateId: string (required)
    //   - timestamp: timestamp (required)
    //   - quantity: number (required)
    //   - voteType: string (free|paid)
    //   - paymentMethod: string
    //   - amountPaid: number
    //
    // Document: config/site
    //   - votePrice: number (admin only)
    //   - eventName: string
    //   - eventDescription: string
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "angekapel007@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'hasVoted', 'role']) &&
             data.id is string &&
             data.name is string &&
             data.email is string &&
             data.hasVoted is bool &&
             data.role in ['user', 'admin'];
    }

    function isValidVote(data) {
      return data.keys().hasAll(['userId', 'candidateId', 'timestamp', 'quantity', 'voteType', 'paymentMethod', 'amountPaid']) &&
             data.userId == request.auth.uid &&
             data.candidateId is string &&
             data.timestamp is timestamp &&
             data.quantity is int &&
             data.quantity >= 1 &&
             data.quantity <= 10000 &&
             data.voteType in ['free', 'paid'] &&
             data.paymentMethod is string &&
             data.amountPaid is number &&
             data.amountPaid >= 0;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && 
        (request.resource.data.role == 'user' || 
         (request.resource.data.role == 'admin' && request.auth.token.email == "angekapel007@gmail.com" && request.auth.token.email_verified == true));
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted', 'totalVotesPurchased']));
    }

    match /candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // Special rule for incrementing/decrementing vote count via batch/transaction
      allow update: if isAuthenticated() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']) &&
                    request.resource.data.voteCount is number &&
                    request.resource.data.voteCount >= 0 &&
                    (
                      (
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasVoted == false &&
                        request.resource.data.voteCount > resource.data.voteCount &&
                        request.resource.data.voteCount <= resource.data.voteCount + 10000
                      ) ||
                      (
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasVoted == true &&
                        request.resource.data.voteCount < resource.data.voteCount &&
                        request.resource.data.voteCount >= resource.data.voteCount - 10000
                      )
                    );
    }

    match /votes/{voteId} {
      allow read: if isAdmin() || isOwner(voteId);
      allow create: if isAuthenticated() && 
                    isOwner(voteId) &&
                    isValidVote(request.resource.data) &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasVoted == false;
      allow delete: if isAdmin() || isOwner(voteId);
    }

    match /admin_emails/{email} {
      allow read, write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() &&
                   request.resource.data.votePrice is number &&
                   request.resource.data.votePrice >= 1 &&
                   request.resource.data.eventName is string &&
                   request.resource.data.eventDescription is string;
    }
  }
}
